# ──────────────────────────────────────────────
# AuditEase AI — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Project ID (found in Supabase dashboard → Settings → General)
VITE_SUPABASE_PROJECT_ID=""

# Supabase API URL (https://<project_id>.supabase.co)
VITE_SUPABASE_URL=""

# Supabase anon/publishable key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=""

# Legacy alias — set to same value as VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── n8n Webhook URLs ──────────────────────────
# CSV upload processing webhook
VITE_N8N_WEBHOOK_CSV=""

# Dispute email generation webhook
VITE_N8N_WEBHOOK_DISPUTES=""

# Contact form submission webhook
VITE_N8N_WEBHOOK_CONTACT=""

# Recovery matching webhook
VITE_N8N_WEBHOOK_RECOVERY=""

# Invoice generation webhook
VITE_N8N_WEBHOOK_INVOICE=""

# Team invitation email webhook
VITE_N8N_WEBHOOK_INVITE_EMAIL=""

# ── Error Monitoring ──────────────────────────
# Sentry DSN (optional — leave blank to disable)
VITE_SENTRY_DSN=""
